# Dependencies
node_modules/

# Kit build output (node kit/build.mjs)
kit/dist/

# The PHP helper's dev install (composer install in adapters/php) — a library commits no lock file
adapters/php/vendor/
adapters/php/composer.lock

# Wrangler local state
.wrangler/

# Local secrets for `wrangler dev` (never committed)
.dev.vars

# A private deployment config (real host, database, site ids) — never committed here
deploy/

# Local scratch
.tmp/

# OS files
.DS_Store
